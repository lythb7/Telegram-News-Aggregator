# ── Telegram ──────────────────────────────────────────────────────────────────
# Get these from https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Session string — generated once by running: npm run auth
# Stores your login so the server can start without interactive input.
TELEGRAM_SESSION_STRING=

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Without this, messages are stored as-is with no summary, headline, or scoring.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model to use for extraction & summarisation (default: claude-haiku-4-5-20251001)
# AI_MODEL=claude-haiku-4-5-20251001

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite — path relative to the project root (or absolute).
# docker-compose.yml overrides this to /app/data/news.db
DATABASE_URL=file:./data/news.db

# ── Storage ───────────────────────────────────────────────────────────────────
# Where downloaded Telegram media is stored.
# docker-compose.yml overrides this to /app/uploads
# UPLOADS_DIR=./uploads

# Maximum media file size to download (MB)
# MAX_MEDIA_SIZE_MB=50

# ── Clustering ─────────────────────────────────────────────────────────────────
# How far back (hours) to look when matching new messages to existing clusters
# CLUSTER_WINDOW_HOURS=12
